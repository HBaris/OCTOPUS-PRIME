# Server Configuration
PORT=3000
WS_PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Binance Testnet Credentials
# WARNING: Keep these secret, never commit actual keys to version control
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here
BINANCE_TESTNET=true

# Trading Safety Settings
# CRITICAL: Always keep false unless you explicitly want to place live testnet orders
ENABLE_REAL_ORDERS=false
MAX_POSITION_SIZE_USD=100.0

# News & Monitoring
RSS_CHECK_INTERVAL_SEC=180
DECISION_SIGNAL_THRESHOLD=70
CORRELATION_CHECK_MINUTES=15

# Sentiment Analysis (Node-native ONNX model via @xenova/transformers)
SENTIMENT_MODEL=Xenova/twitter-xlm-roberta-base-sentiment
