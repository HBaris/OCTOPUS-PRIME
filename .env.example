# Server Configuration
PORT=3000
WS_PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Exchange Provider Selection ('binance' | 'okx')
EXCHANGE_PROVIDER=binance

# Binance Testnet Credentials
# WARNING: Keep these secret, never commit actual keys to version control
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here
BINANCE_TESTNET=true

# OKX Demo Trading Credentials
OKX_API_KEY=your_okx_demo_api_key_here
OKX_SECRET=your_okx_demo_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# Leverage & Margin Settings
DEFAULT_LEVERAGE=5
DEFAULT_MARGIN_MODE=isolated
MAX_LEVERAGE_ALLOWED=10

# Trading Safety Settings
# CRITICAL: Always keep false unless you explicitly want to place live testnet orders
ENABLE_REAL_ORDERS=false
MAX_POSITION_SIZE_USD=100.0

# News & Monitoring
RSS_CHECK_INTERVAL_SEC=180
DECISION_SIGNAL_THRESHOLD=70
CORRELATION_CHECK_MINUTES=15
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# Social Intelligence (Telegram & Threads)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_CHANNELS=crypto_signals_vip,binance_kill_zone
THREADS_TARGET_URL=https://www.threads.net

# Circuit Breaker / Cooldown Settings
COOLDOWN_CONSECUTIVE_LOSSES=3
COOLDOWN_DURATION_MINUTES=30
MARKET_STREAM_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Sentiment Analysis (Public multilingual sentiment model via @xenova/transformers)
SENTIMENT_MODEL=Xenova/distilbert-base-multilingual-cased-sentiments-student

